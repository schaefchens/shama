<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.schaefchens.shama.speechbench">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application android:label="Shama speech bench" android:debuggable="true">
        <activity android:name=".BenchActivity" android:exported="true" />
    </application>
</manifest>
