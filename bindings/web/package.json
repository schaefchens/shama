{
  "name": "@schaefchens/shama-web",
  "version": "0.0.0",
  "description": "Shama in the browser: the core as WASM in a worker, the microphone in an AudioWorklet, the device's voice and language model",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/schaefchens/shama.git",
    "directory": "bindings/web"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:wasm": "sh build.sh",
    "build": "sh build.sh && tsc && cp -R src/generated src/capture-worklet.js dist/",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=source --test test/"
  },
  "dependencies": {
    "@schaefchens/shama": "*"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
